# Параметры учебного стенда (пароли — только для локальной демонстрации!)
WEB_PORT=8080
APP_PORT=5000

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=notes
MYSQL_USER=notes_app
MYSQL_PASSWORD=notespass

# Резервное копирование: период (сек) и сколько копий хранить
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
