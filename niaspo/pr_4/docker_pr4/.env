# Практическая работа №4 (часть 1). Порты контейнеров.
# Меняются здесь — пересобирать образы не нужно, достаточно `docker compose up -d`.
# ВАЖНО: в режиме network_mode: host порты занимаются на самой машине,
# поэтому перед сменой проверь, что новые номера свободны (ss -tulpn).
GATEWAY_PORT=8081
COMPUTE_PORT=8082
